      "title": "Question"
    },
    "r_ohm": {
      "maximum": 1000000.0,
      "minimum": 10,
      "title": "R Ohm",
      "type": "number"
    },
    "c_f": {
      "maximum": 0.001,
      "minimum": 1e-12,
      "title": "C F",
      "type": "number"
    },
    "pulse": {
      "$ref": "#/$defs/Pulse"
    },
    "ac": {
      "$ref": "#/$defs/AC"
    },
    "transient": {
      "$ref": "#/$defs/Transient"
    }
  },
  "required": [
